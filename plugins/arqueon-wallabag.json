{
    "id": "wallabag",
    "name": "Wallabag",
    "capabilities": [
        "dankbar-widget"
    ],
    "category": "productivity",
    "repo": "https://github.com/arqueon/dms-wallabag",
    "description": "Your Wallabag read-it-later queue in the DankBar: unread badge, entries and excerpts, batch actions, search and quick-add. OAuth2 secrets stay in the system keyring and reach curl through stdin. Optional thumbnails load directly from article hosts and are off by default.",
    "version": "0.1.3",
    "author": "arqueon",
    "icon": "bookmark",
    "type": "widget",
    "component": "./WallabagWidget.qml",
    "settings": "./Settings.qml",
    "startupCheck": "./StartupCheck.qml",
    "permissions": [
        "settings_read",
        "settings_write",
        "network",
        "process"
    ],
    "requires_dms": ">=1.2.0",
    "dependencies": [
        "curl",
        "secret-tool"
    ],
    "compositors": [
        "any"
    ],
    "distro": [
        "any"
    ],
    "screenshot": "https://raw.githubusercontent.com/arqueon/dms-wallabag/main/assets/screenshot.png"
}
