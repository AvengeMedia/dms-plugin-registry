{
    "id": "simNetwork",
    "name": "SIM Network",
    "capabilities": [
        "daemon",
        "control-center",
        "dankbar-widget"
    ],
    "category": "networking",
    "repo": "https://github.com/chenshifanjian/dms-sim-network",
    "author": "chenshifanjian",
    "description": "管理 4G 模块：流量与实时网速、短信与彩信收发、GPS 定位、桌面通知、短信归档到 Obsidian。硬件与运营商限制：彩信收发与话费查询仅针对 Quectel EG25-G + 中国电信，接收彩信需另装 mmsd-tng；扩展功能需手工安装 extras 脚本。公网 IP 查询仅在手动点击时向 api64.ipify.org 发一次请求。安装细节见 README。",
    "dependencies": [
        "mmcli",
        "nmcli",
        "ip",
        "curl",
        "zenity"
    ],
    "compositors": [
        "niri"
    ],
    "distro": [
        "any"
    ],
    "screenshot": "https://raw.githubusercontent.com/chenshifanjian/dms-sim-network/main/docs/screenshot.png",
    "requires_dms": ">=1.6.0"
}
