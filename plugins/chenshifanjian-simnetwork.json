{
    "id": "simNetwork",
    "name": "SIM Network",
    "capabilities": [
        "daemon",
        "control-center",
        "dankbar-widget"
    ],
    "category": "networking",
    "repo": "https://github.com/chenshifanjian/dms-sim-network",
    "author": "chenshifanjian",
    "description": "管理 4G 模块：流量与实时网速、短信/彩信收发、GPS 定位、桌面通知与 Obsidian 归档。彩信发送/自愈/话费查询针对 Quectel EG25-G + 中国电信，并需手工安装 extras 脚本（含 python3 + pyserial）与一条仅放行 systemctl start/stop ModemManager 的免密规则",
    "dependencies": [
        "mmcli",
        "nmcli"
    ],
    "compositors": [
        "niri"
    ],
    "distro": [
        "any"
    ],
    "screenshot": "https://raw.githubusercontent.com/chenshifanjian/dms-sim-network/main/docs/screenshot.png",
    "requires_dms": ">=1.6.0"
}
